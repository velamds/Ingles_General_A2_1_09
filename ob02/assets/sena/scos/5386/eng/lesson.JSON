 "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn4le09ob02re2aud01", "coverimg": "engenn4le09ob02re2img01.jpg", "images": [{"image": "engenn4le09ob02re2img01.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn4le09ob02re2img01.jpg", "text": "<span class=\"strong\">Tourist</span>: Excuse me. May I ask you something?", "time": "100", "id": 1}, {"image": "engenn4le09ob02re2img05.jpg", "text": "<span class=\"strong\">John</span>: Of course. How can I help you?<br>\n<span class=\"strong\">Tourist</span>: Well, I was here last year. There was a clothing stall I really liked, but I can't seem to find it.<br>\n<span class=\"strong\">John</span>:  You can find many articles of clothing with geometric patterns here.", "time": "4000", "id": 2}, {"image": "engenn4le09ob02re2img05.jpg", "text": "<span class=\"strong\">Tourist</span>: I don't recognize the streets. Last year, the market looked different for some reason.<br>\n<span class=\"strong\">John</span>: How so?<br>\n<span class=\"strong\">Tourist</span>: It was quiet, and there weren't so many people.<br>\n<span class=\"strong\">John</span>: Do you remember when you visited the market?<br>\n<span class=\"strong\">Tourist</span>: It was in November.", "time": "19000", "id": 3}, {"image": "engenn4le09ob02re2img02.jpg", "text": "<span class=\"strong\">John</span>: There you go! November is not the tourist season!<br>\n<span class=\"strong\">Tourist</span>: The market looks vibrant now! It is the highlight of our trip so far!<br>\n<span class=\"strong\">John</span>: I agree.<br>\n<span class=\"strong\">Tourist</span>: Can I ask you something else?", "time": "37000", "id": 4}, {"image": "engenn4le09ob02re2img02.jpg", "text": "<span class=\"strong\">John</span>: Sure. What is it?<br>\n<span class=\"strong\">Tourist</span>: What time do we leave? I want to find that stall ...", "time": "52000", "id": 5}]}}], "id": 1}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "John in Belize", "type": "lesson_name"}, {"content": "Last Year It Was Different", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "scholar > Nature Around Us > Great Barrier Reef", "type": "origin"}, {"content": 9, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_8"}]}, {"content": "engenn4le09ob02re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Talking To Strangers", "type": "heading"}, {"content": "When you are traveling, you meet new people (strangers).  You can get their attention with expressions like <span class=\"italic\">Excuse me?</span> <span class=\"italic\">Can I ask you something?</span> or <span class=\"italic\">Nice to meet you.</span><br>   ", "type": "describer"}, {"content": "<span class=\"strong\">Ann</span>: Excuse me, may I ask you something?<br><span class=\"strong\">Stranger</span>: Of course. How can I help you?", "type": "example"}, {"content": "<span class=\"strong\">Ann</span>: Can I ask you something else?<br><span class=\"strong\">Stranger</span>: Sure! What is it?", "type": "example"}, {"content": "<span class=\"strong\">Ann</span>: When does  the next bus leave?<br><span class=\"strong\">Stranger</span>: There's a schedule over there at the bus stop.", "type": "example"}, {"content": "A stranger is someone you do not know. They can be from your own country.<br>  <br>When you talk to strangers, use <span class=\"strong\">small talk</span> (<span class=\"italic\">informal chat about the weather,  the city you are in, or general details about you</span>).<br> </br> When you ask questions you can use modals for requests or Wh-/Hw- questions.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "article ", "type": "name"}, {"content": "An item", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Here you can find many articles of clothing.", "type": "example"}, {"content": "engenn4le09ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you visit a market.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "geometric", "type": "name"}, {"content": "made with regular shapes and lines", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I like the blanket with the geometric design.", "type": "example"}, {"content": "engenn4le09ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "pattern", "type": "name"}, {"content": "a repeated decorative design", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There are many shirts with geometric patterns in the market.", "type": "example"}, {"content": "engenn4le09ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to recognize", "type": "name"}, {"content": "to identify, to know again", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I don't recognize the streets.", "type": "example"}, {"content": "engenn4le09ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "tourist season", "type": "name"}, {"content": "a popular time of the year for tourists ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: July is our tourist season.", "type": "example"}, {"content": "engenn4le09ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "so far", "type": "name"}, {"content": "up to now", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: The market is the highlight of our trip so far.", "type": "example"}, {"content": "engenn4le09ob02aud06", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Write a dialogue (5-8 lines).", "type": "text"}, {"content": "Use expressions and questions to start the conversation.", "type": "text"}, {"content": "Reply to the stranger's questions.", "type": "text"}, {"content": "Read your dialogue aloud.", "type": "text"}, {"content": "Exchange roles.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I use expressions to talk to a stranger.", "type": "text"}, {"content": "I ask questions and make requests.", "type": "text"}, {"content": "I practice pronunciation by reading aloud.", "type": "text"}]}]}