{"_data": [{"contents": [{"content": "John in Belize", "type": "lesson_name"}, {"content": "A Health History Form", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "scholar > Between the Market Stalls > Guatemala Crafts", "type": "origin"}, {"content": 9, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Identify  health problems and ways of staying healthy, and use them in a limited range of social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_2"}, {"content": "Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative topics for this level.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle. ", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn4le09ob08re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Health History Form", "type": "heading"}, {"content": "Health care providers use a health history form to get a history of any health issues or conditions.<br> <br> This information can let people know about your health if you are in an accident.  This information can help providers like doctors and paramedics treat you if you are in an accident.<br><br> The personal information you write on a health history form needs to be accurate.<br><br>The information on a health history form is private.</p>The questions on a health history form are generally in the <span class=\"strong\">Simple Present</span> tense or the <span class=\"strong\">Simple Past</span> tense.", "type": "describer"}, {"content": "When did you last see a physician?", "type": "example"}, {"content": "Are you here for a particular reason? If so, when did this problem begin?", "type": "example"}, {"content": "What medications do you currently take?", "type": "example"}, {"content": "Do you smoke?", "type": "example"}, {"content": "How much alcohol do you consume?", "type": "example"}, {"content": "How often do you exercise?", "type": "example"}, {"content": "Do you take vitamin supplements?", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "accurate", "type": "name"}, {"content": "free from mistakes and errors", "type": "definition"}, {"content": "(adjective)  ", "type": "part_speech"}, {"content": "Example: Health forms need to be accurate.", "type": "example"}, {"content": "engenn4le09ob08aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use in health care.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "health care provider ", "type": "name"}, {"content": "a group or company that provides care to people who are sick or injured", "type": "definition"}, {"content": "(adjective)  ", "type": "part_speech"}, {"content": "Example: My health care provider is well-known in the community.", "type": "example"}, {"content": "engenn4le09ob08aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to treat", "type": "name"}, {"content": "to give medical care", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The doctor treated the patient in the hospital.", "type": "example"}, {"content": "engenn4le09ob08aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "condition ", "type": "name"}, {"content": "a sickness or disease that a person has for a long time ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Did you write down your medical condition on the form?", "type": "example"}, {"content": "engenn4le09ob08aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "risky", "type": "name"}, {"content": "the possibility of something bad happening ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Some outdoor activities can be risky.", "type": "example"}, {"content": "engenn4le09ob08aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to drown ", "type": "name"}, {"content": "to die from being underwater too long ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You can drown if you swim in a river.", "type": "example"}, {"content": "engenn4le09ob08aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "paddle", "type": "name"}, {"content": "a long,  wooden pole you move through the water to move a small boat ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You need a paddle to use the boat.", "type": "example"}, {"content": "engenn4le09ob08aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "solo ", "type": "name"}, {"content": "something that is done alone ", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: Are you paddling solo in this race?", "type": "example"}, {"content": "engenn4le09ob08aud08", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "life jacket ", "type": "name"}, {"content": "something worn over your upper body like a jacket to save you from drowning ", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: Wear your life jacket when you are paddling a boat.", "type": "example"}, {"content": "engenn4le09ob08aud09", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "edge ", "type": "name"}, {"content": "where an area begins or ends ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Walk towards the river's edge.", "type": "example"}, {"content": "engenn4le09ob08aud10", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Interview a family member.", "type": "text"}, {"content": "Complete the table with their health information.", "type": "text"}, {"content": "Read the form to the family member.", "type": "text"}, {"content": "{\"rows\":9,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"1. Name:\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"6. Date of Last Examination:\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"2. Address:\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"7. Height and Weight:\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"3. Phone Number:\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \